# ==============================================================================
# On-Premises DevSecOps Stack — Environment Configuration
# ==============================================================================
# Copy this file to `.env` (in the same onprem/ directory) and fill in the
# values below BEFORE running `sudo bash onprem/setup.sh`:
#
#   cp onprem/.env.example onprem/.env
#
# NEVER commit the real `.env` file — it is gitignored. This example file
# contains placeholders only, no real secrets.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# SonarQube
# ------------------------------------------------------------------------------
# The admin password setup.sh sets on first boot (replaces the default "admin").
# REQUIRED — set your own strong value. The broker derives its admin token from
# this, so setup.sh fails fast if it is left unset.
SONARQUBE_ADMIN_PASSWORD=change-me-strong-password

# ------------------------------------------------------------------------------
# DefectDojo
# ------------------------------------------------------------------------------
# Generate each of the three values below with:
#   openssl rand -base64 32
# (the GCP startup-script generated these randomly on the server).
DD_DATABASE_PASSWORD=generate-with-openssl-rand-base64-32
DD_SECRET_KEY=generate-with-openssl-rand-base64-32
DD_CREDENTIAL_AES_256_KEY=generate-with-openssl-rand-base64-32

# ------------------------------------------------------------------------------
# Credential broker
# ------------------------------------------------------------------------------
# The broker reaches SonarQube + DefectDojo server-side on behalf of clients so
# that laptops and CI store no privileged secrets.
#
# DefectDojo admin creds (same names the DefectDojo initializer reads). The
# broker authenticates with these to obtain its API key. On a FRESH DefectDojo
# init these set the admin login; on an already-initialized instance, either
# reset the admin password to match or set DEFECTDOJO_API_KEY below.
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=change-me-strong-password

# Product type the broker creates/uses in DefectDojo (auto-created if absent).
DD_PRODUCT_TYPE_NAME=cs-devtest

# Internal URLs the broker uses to reach each service (defaults shown).
SONAR_INTERNAL_URL=http://sonarqube:9000
DEFECTDOJO_URL=http://host.docker.internal:8080

# Public SonarQube URL the broker returns to clients (/sonar/provision, /config).
# Set this to the server's LAN address.
SONAR_PUBLIC_URL=http://192.168.1.50:9000

# Optional overrides — if set, the broker uses these directly and skips the
# startup credential derivation above.
# SONAR_ADMIN_TOKEN=
# DEFECTDOJO_API_KEY=

# ------------------------------------------------------------------------------
# Grafana Cloud (SaaS — unchanged from the GCP setup)
# ------------------------------------------------------------------------------
# Grafana Cloud stays hosted by Grafana; the CI pipeline still pushes metrics,
# logs, and traces there. These same values must also be stored as GitHub
# Secrets (see PIPELINE_README.md). They are listed here for reference / local
# tooling only.
GRAFANA_API_KEY=glc_your_grafana_cloud_api_key
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-region.grafana.net/api/prom/push
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_TEMPO_URL=https://tempo-prod-XX.grafana.net:443
