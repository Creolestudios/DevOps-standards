# ==============================================================================
# On-Premises DevSecOps Stack — Environment Configuration
# ==============================================================================
# Fastest path: let the generator create onprem/.env for you with random
# secrets and this machine's LAN subnet/IP filled in:
#
#   sudo bash onprem/gen-env.sh
#
# Or copy this file by hand and replace every placeholder:
#
#   cp onprem/.env.example onprem/.env && chmod 600 onprem/.env
#
# This file is read by bash (firewall.sh, setup.sh) AND by Docker Compose (the
# broker's env_file). Keep values on one line, and do not use spaces, quotes,
# $, `, \ or # inside values (except the quoted LAN_CIDRS list below).
#
# NEVER commit the real `.env` file — it is gitignored.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Network — the ONE place the office subnet is configured
# ------------------------------------------------------------------------------
# Space-separated CIDRs allowed to reach the services. Used by firewall.sh (ufw)
# and by the DOCKER-USER rules for Docker-published ports. Add every office
# subnet that needs access (wired, Wi-Fi, VPN). Example: "192.168.2.0/24".
LAN_CIDRS="192.168.2.0/24"
# Optional IPv6 office CIDRs (space-separated). Leave empty if unused.
LAN_CIDRS6=""
# Optional extra TCP ports to open to LAN_CIDRS in ufw (space-separated), e.g.
# "80" if colleagues use the Apache site on this machine. Empty = none.
EXTRA_LAN_PORTS=""

# ------------------------------------------------------------------------------
# SonarQube
# ------------------------------------------------------------------------------
# Admin password setup.sh sets on first boot (replaces the default "admin").
# SonarQube rule: at least 12 characters with an upper-case letter, a lower-case
# letter, a digit and a special character. setup.sh rejects this placeholder.
SONARQUBE_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# DefectDojo
# ------------------------------------------------------------------------------
# Generate each value with:   openssl rand -hex 32
# (hex only — base64 output can contain / + = which break the database URL).
# DD_DATABASE_PASSWORD only takes effect when the Postgres volume is created;
# changing it later does not change the existing database password.
DD_DATABASE_PASSWORD=CHANGE_ME
DD_SECRET_KEY=CHANGE_ME
DD_CREDENTIAL_AES_256_KEY=CHANGE_ME

# DefectDojo admin login. Set on FIRST initialization only; the broker also uses
# it to obtain its API key. On an already-initialized instance either reset the
# admin password to match, or set DEFECTDOJO_API_KEY below.
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# Credential broker
# ------------------------------------------------------------------------------
# Public SonarQube URL the broker hands to developers and CI. Use this server's
# LAN IP (or a DNS name that resolves to it), e.g. http://192.168.2.50:9000
SONAR_PUBLIC_URL=http://CHANGE_ME:9000

# Product type the broker creates/uses in DefectDojo (auto-created if absent).
DD_PRODUCT_TYPE_NAME=cs-devtest

# Internal URLs the broker uses (both are aliases on the devsecops-net network).
SONAR_INTERNAL_URL=http://sonarqube:9000
DEFECTDOJO_URL=http://defectdojo:8080

# Optional overrides — if set, the broker uses these directly and skips the
# startup credential derivation above.
# SONAR_ADMIN_TOKEN=
# DEFECTDOJO_API_KEY=

# ------------------------------------------------------------------------------
# Grafana Cloud (SaaS — unchanged from the GCP setup)
# ------------------------------------------------------------------------------
# Grafana Cloud stays hosted by Grafana; the CI pipeline still pushes metrics,
# logs, and traces there. These same values must also be stored as GitHub
# Secrets (see PIPELINE_README.md). They are listed here for reference only.
GRAFANA_API_KEY=glc_your_grafana_cloud_api_key
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-region.grafana.net/api/prom/push
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_TEMPO_URL=https://tempo-prod-XX.grafana.net:443
